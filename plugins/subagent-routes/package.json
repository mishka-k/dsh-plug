{
  "name": "dsh-subagent-routes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Let agents choose provider, model and reasoning effort for subagents in every session, not only in fresh chats.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "keywords": ["dsh", "dsh-plugin", "subagents", "models"],
  "engines": { "node": ">=24" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-plugins"]
    }
  },
  "license": "MIT"
}
